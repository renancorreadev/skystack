# SkyStack — environment variables
#
# Copy to `.env` and adjust. NOTE: SkyStack has no dotenv loader — nothing reads
# this file automatically. It documents the variables the binaries read from the
# process environment. To apply them:
#
#   set -a && . ./.env && set +a      # sh/bash/zsh
#   export (cat .env | grep -v '^#' | xargs -L1)   # fish
#
# For the GUI app (which does not inherit your shell), set them with:
#   launchctl setenv SKYSTACK_BIN /path/to/skystack
#
# All values below are OPTIONAL — SkyStack auto-detects sane defaults for every
# one of them. There are no secrets or credentials here; remote host access is
# configured in ~/.skystack/hosts.yaml, not via env vars.


# ─── CLI (skystack) ──────────────────────────────────────────────────────────

# Disable ANSI colors in CLI output. Any non-empty value turns color off.
# Color is also auto-disabled when stdout is not a TTY (pipes, CI).
# Read by: skystack/internal/ui/render.go
NO_COLOR=

# Docker engine endpoint for the *local* host. Normally left unset so the
# standard unix socket is used. SkyStack sets this itself per-host when it
# shells out to `docker compose` / `docker build`, deriving the value from
# ~/.skystack/hosts.yaml (host.docker, falling back to host.ssh).
# Examples: unix:///var/run/docker.sock | ssh://user@server | tcp://127.0.0.1:2375
# Read by: skystack/internal/core/client.go, internal/cli/{compose,build,api}.go
DOCKER_HOST=


# ─── macOS app (SkyStack.app) ────────────────────────────────────────────────

# Absolute path to the `skystack` CLI binary. Overrides binary discovery.
# Must point at an executable file or it is ignored.
# Default search order: bundled in the .app → sibling of the executable →
#   /opt/homebrew/bin/skystack → /usr/local/bin/skystack → ~/.local/bin/skystack
# Useful in development to point the app at a local build:
#   SKYSTACK_BIN=/Users/you/Desktop/rocket/skystack/bin/skystack
# Read by: app/Sources/SkyStackApp/Backend/SkyCLI.swift (resolveBinary)
SKYSTACK_BIN=

# Force the background daemon transport on or off.
#   1       always route reads through the daemon
#   0       never use the daemon (always use `skystack api`)
#   unset   auto — use the daemon when ~/.skystack/daemon.sock exists
# Reads fall back to `api` if a daemon call fails, so forcing it on is safe.
# Read by: app/Sources/SkyStackApp/Backend/SkyCLI.swift (init)
SKYSTACK_DAEMON=

# Absolute path to the Claude Code CLI (`claude`), used by the app's AI features.
# Must point at an executable file or it is ignored.
# Default search order: /opt/homebrew/bin/claude → /usr/local/bin/claude →
#   ~/.claude/local/claude → /usr/bin/claude
# Read by: app/Sources/SkyStackApp/Backend/SkyCLI.swift (resolveClaude)
CLAUDE_BIN=


# ─── Inherited from the system (do not set here) ─────────────────────────────
#
# HOME  locates the state directory ~/.skystack (hosts.yaml, daemon.sock, ca/).
#       Read by skystack/internal/config/config.go and SkyVM.
# TERM  the app's embedded terminal forces `xterm-256color` on the child shell.
# LANG  the embedded terminal defaults it to `en_US.UTF-8` when unset.
