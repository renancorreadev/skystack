<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required to create and run VMs via Virtualization.framework. -->
    <key>com.apple.security.virtualization</key>
    <true/>
    <!-- Required for the Rosetta directory share (linux/amd64 on Apple Silicon). -->
    <key>com.apple.security.virtualization.rosetta</key>
    <true/>
</dict>
</plist>
